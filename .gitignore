# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/

# Distribution / packaging
build/
dist/
*.egg-info/

# Coverage / test artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / editor
.vscode/
.idea/

# Local Python version (pyenv)
.python-version

# Runtime data / logs (local stack volumes)
data/
logs/
*.log

# Local stack secrets
stack/notifiers/telegram_bot_token.yaml
stack/telegram_notifier_bot_token.yaml
.env
.env.*
!.env.example

# SQLite / local DBs outside ignored data/ (safety net)
*.sqlite3
*.db
